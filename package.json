{
    "name": "vscode-resource-monitor",
    "displayName": "VSCode Resource Monitor",
    "description": "%extension.description%",
    "version": "2026.421.235133",
    "publisher": "vscode-resource-monitor",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/bcong"
    },
    "bugs": {
        "url": "https://github.com/bcong"
    },
    "homepage": "https://github.com/bcong",
    "keywords": [
        "cpu",
        "gpu",
        "ram",
        "memory",
        "disk",
        "network",
        "resource",
        "monitor",
        "status bar",
        "system info",
        "performance"
    ],
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "%config.title%",
            "properties": {
                "resourceMonitor.showCpu": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.showCpu%"
                },
                "resourceMonitor.showMemory": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.showMemory%"
                },
                "resourceMonitor.showGpu": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.showGpu%"
                },
                "resourceMonitor.showGpuMemory": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.showGpuMemory%"
                },
                "resourceMonitor.showDisk": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.showDisk%"
                },
                "resourceMonitor.showNetwork": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.showNetwork%"
                },
                "resourceMonitor.showCpuTemp": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.showCpuTemp%"
                },
                "resourceMonitor.showGpuTemp": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.showGpuTemp%"
                },
                "resourceMonitor.showBattery": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.showBattery%"
                },
                "resourceMonitor.showProcessCount": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.showProcessCount%"
                },
                "resourceMonitor.updateInterval": {
                    "type": "number",
                    "default": 2000,
                    "minimum": 500,
                    "maximum": 30000,
                    "description": "%config.updateInterval%"
                },
                "resourceMonitor.statusBarPosition": {
                    "type": "string",
                    "enum": [
                        "left",
                        "right"
                    ],
                    "default": "right",
                    "description": "%config.statusBarPosition%"
                },
                "resourceMonitor.statusBarPriority": {
                    "type": "number",
                    "default": 100,
                    "description": "%config.statusBarPriority%"
                },
                "resourceMonitor.memoryUnit": {
                    "type": "string",
                    "enum": [
                        "GB",
                        "MB",
                        "percent"
                    ],
                    "default": "GB",
                    "description": "%config.memoryUnit%"
                },
                "resourceMonitor.networkUnit": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "KB/s",
                        "MB/s"
                    ],
                    "default": "auto",
                    "description": "%config.networkUnit%"
                },
                "resourceMonitor.order": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "cpu",
                            "memory",
                            "gpu",
                            "gpuMemory",
                            "disk",
                            "network",
                            "battery",
                            "processCount"
                        ]
                    },
                    "default": [
                        "cpu",
                        "memory",
                        "gpu",
                        "gpuMemory",
                        "disk",
                        "network",
                        "battery",
                        "processCount"
                    ],
                    "description": "%config.order%"
                }
            }
        },
        "commands": [
            {
                "command": "resourceMonitor.openSettings",
                "title": "%command.openSettings%"
            },
            {
                "command": "resourceMonitor.toggle",
                "title": "%command.toggle%"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run obfuscate",
        "compile": "tsc -p ./",
        "obfuscate": "node scripts/obfuscate.js",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "deploy": "vsce publish --no-yarn --allow-missing-repository"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.85.0",
        "javascript-obfuscator": "^5.4.1",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "systeminformation": "^5.22.0"
    }
}